[Icon Theme]
Name=Slot-Dark-Icons-V-2
Comment=Slot Dark Icons for dark interfaces
Inherits=breeze-dark,elementary,Adwaita,gnome,hicolor

Example=folder

FollowsColorScheme=true

DesktopDefault=48
DesktopSizes=16,22,24,32,48,64
ToolbarDefault=22
ToolbarSizes=16,22,24,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,24,32,48
SmallDefault=16
SmallSizes=16,22,24,32,48
PanelDefault=48
PanelSizes=16,22,24,32,48,64
DialogDefault=48
DialogSizes=16,22,24,32,48,64

Directories=actions/16,actions/18,actions/22,actions/24,actions/symbolic,animations,apps/scalable,apps/symbolic,categories/scalable,categories/symbolic,preferences/22,preferences/32,devices/scalable,devices/symbolic,emblems/scalable,emblems/symbolic,mimetypes/scalable,mimetypes/symbolic,panel/16,panel/16@2x,panel/22,panel/22@2x,panel/24,panel/24@2x,places/16,places/scalable,places/symbolic,status/scalable/16,status/scalable/32,status/scalable/512,status/symbolic

[actions/16]
Context=Actions
Size=16
Type=Fixed

[actions/18]
Context=Actions
Size=18
Type=Fixed

[actions/22]
Context=Actions
Size=22
Type=Fixed

[actions/24]
Context=Actions
Size=24
Type=Fixed

[actions/symbolic]
Context=Actions
Size=16
MinSize=16
MaxSize=512
Type=Scalable

[animations]
Context=Animations
Size=24
MinSize=16
MaxSize=512
Type=Scalable

[apps/scalable]
Context=Applications
Size=128
MinSize=16
MaxSize=512
Type=Scalable

# Hacky trick for Xfce icons - - - - - - - - - - - - - - - - - - - - - - - - - -
[apps/scalable]
Context=Applications
Size=16
Type=Fixed

[apps/scalable]
Context=Applications
Size=22
Type=Fixed

[apps/scalable]
Context=Applications
Size=24
Type=Fixed
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

[apps/symbolic]
Context=Applications
Size=512
MinSize=16
MaxSize=512
Type=Scalable

[categories/scalable]
Context=Categories
Size=512
MinSize=16
MaxSize=512
Type=Scalable

[categories/symbolic]
Context=Actions
Size=16
MinSize=16
MaxSize=512
Type=Scalable

[devices/scalable]
Context=Devices
Size=512
MinSize=16
MaxSize=512
Type=Scalable

[devices/symbolic]
Context=Devices
Size=16
MinSize=16
MaxSize=512
Type=Scalable

[emblems/scalable]
Context=Emblems
Size=24
MinSize=16
MaxSize=512
Type=Scalable

[emblems/symbolic]
Context=Emblems
Size=16
MinSize=16
MaxSize=512
Type=Scalable

[mimetypes/scalable]
Context=MimeTypes
Size=48
MinSize=16
MaxSize=512
Type=Scalable

[mimetypes/symbolic]
Context=MimeTypes
Size=16
MinSize=16
MaxSize=512
Type=Scalable

# Have to be Fixed type and 22/24 sizes needed to fix rendering issues in Budgie

[panel/16]
Context=Status
Size=16
Type=Fixed

[panel/16@2x]
Context=Status
Size=16
Scale=2
Type=Fixed

[panel/22]
Context=Status
Size=22
Type=Fixed

[panel/22@2x]
Context=Status
Size=22
Scale=2
Type=Fixed

[panel/24]
Context=Status
Size=24
Type=Fixed

[panel/24@2x]
Context=Status
Size=24
Scale=2
Type=Fixed

[places/16]
Context=Places
Size=16
MinSize=16
MaxSize=512
Type=Fixed

[places/scalable]
Context=Places
Size=512
MinSize=16
MaxSize=512
Type=Scalable

[places/symbolic]
Context=Places
Size=16
MinSize=16
MaxSize=512
Type=Scalable

[status/scalable/16]
Context=Status
Size=16
MinSize=16
MaxSize=512
Type=Scalable

[status/scalable/32]
Context=Status
Size=32
MinSize=16
MaxSize=512
Type=Scalable

[status/scalable/512]
Context=Status
Size=512
MinSize=16
MaxSize=512
Type=Scalable

[status/symbolic]
Context=Status
Size=16
MinSize=16
MaxSize=512
Type=Scalable

#32x32 - Scalable - For System Settings icons >!!!ONLY!!!< - Scalable to the following sizes: 32x32 (default), 64x64, 128x128, 256x256 - DO_NOT_USE_ANYWHERE_ELSE - Color
[preferences/32]
Size=32
Context=Applications
Type=Fixed

#22x22 - Fixed size - For System Settings icons >!!!ONLY!!!< - DO_NOT_USE_ANYWHERE_ELSE - Color
[preferences/22]
Size=22
Context=Applications
Type=Fixed
